</head>
<body class="bg-neutral-950 text-neutral-100 antialiased selection:bg-amber-500 selection:text-black overflow-x-hidden">

  <!-- NAVBAR GLASSMORPHIC -->
  <header class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-8 py-4 transition-all duration-300">
    <div class="max-w-7xl mx-auto">
      <nav class="glass-panel rounded-full px-6 py-3 flex items-center justify-between shadow-2xl">
        <!-- LOGO -->
        <a href="#" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-black font-extrabold tracking-tighter shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
            WCQ
          </div>
          <span class="text-lg font-extrabold tracking-wider text-white uppercase group-hover:text-amber-400 transition-colors">
            West Coast <span class="text-amber-500">Quad</span>
          </span>
        </a>

        <!-- NAV LINKS -->
        <div class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wide text-neutral-300">
          <a href="#about" class="hover:text-amber-400 transition-colors">Chi Siamo</a>
          <a href="#percorsi" class="hover:text-amber-400 transition-colors">I Percorsi</a>
          <a href="#galleria" class="hover:text-amber-400 transition-colors">Galleria</a>
          <a href="#contatti" class="hover:text-amber-400 transition-colors">Contatti</a>
        </div>

        <!-- CTA CTA PHONE -->
        <a href="tel:+393460207324" class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-neutral-950 font-bold px-5 py-2.5 rounded-full text-xs uppercase tracking-wider transition-all duration-300 shadow-lg shadow-amber-500/20 hover:shadow-amber-500/40 hover:-translate-y-0.5">
          <i data-lucide="phone" class="w-4 h-4"></i>
          <span>+39 346 0207324</span>
        </a>
      </nav>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="relative h-screen w-full flex items-center justify-center overflow-hidden bg-cover bg-center bg-no-repeat" style="background-image: url('https://www.westcoastquad.it/wp-content/uploads/2024/08/hero21.jpg');">
    <!-- DARK OVERLAY GRADIENTS -->
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/60 to-black/50"></div>
    <div class="absolute inset-0 bg-radial from-transparent via-black/40 to-neutral-950"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center pt-20">
      <!-- BADGE HERO -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-panel text-amber-400 text-xs uppercase tracking-widest font-semibold mb-6 border border-amber-500/30">
        <i data-lucide="compass" class="w-4 h-4 text-amber-400 animate-spin-slow"></i>
        <span>Sito Ufficiale · West Coast Quad</span>
      </div>

      <!-- TITOLO PRINCIPALE -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        Diventa il Protagonista della Tua <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600">Prossima Avventura</span>
      </h1>

      <!-- SOTTOTITOLO -->
      <p class="text-lg sm:text-xl text-neutral-300 max-w-3xl mx-auto font-light leading-relaxed mb-10">
        Esplora la natura come un vero eroe con le nostre emozionanti escursioni in quad. Senti l’adrenalina correre nelle tue vene mentre esplori paesaggi mozzafiato e vivi avventure indimenticabili.
      </p>

      <!-- BOTTONI AZIONE -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#percorsi" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-amber-500 hover:bg-amber-400 text-neutral-950 font-extrabold px-8 py-4 rounded-full text-sm uppercase tracking-wider transition-all duration-300 shadow-xl shadow-amber-500/25 hover:scale-105">
          <span>Esplora i Percorsi</span>
          <i data-lucide="arrow-down-right" class="w-5 h-5"></i>
        </a>
        <a href="tel:+393460207324" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 glass-panel hover:bg-white/10 text-white font-bold px-8 py-4 rounded-full text-sm uppercase tracking-wider transition-all duration-300 border border-white/20">
          <i data-lucide="phone-call" class="w-4 h-4 text-amber-400"></i>
          <span>Prenota Ora</span>
        </a>
      </div>
    </div>

    <!-- STATS QUICK BAR -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 w-full max-w-4xl px-4 hidden md:block">
      <div class="glass-panel rounded-2xl p-4 grid grid-cols-3 divide-x divide-white/10 text-center">
        <div>
          <p class="text-xs uppercase tracking-widest text-neutral-400">Distanza Max</p>
          <p class="text-xl font-bold text-amber-400 mt-1">Fino a 100 KM</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-neutral-400">Durata</p>
          <p class="text-xl font-bold text-white mt-1">Fino a 7 Ore</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-widest text-neutral-400">Esperienza</p>
          <p class="text-xl font-bold text-amber-400 mt-1">Adatta a Tutti</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CHI SIAMO / MISSION SECTION -->
  <section id="about" class="py-24 px-6 relative bg-neutral-950 overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- TESTO MISSION -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 text-amber-500 font-bold text-xs uppercase tracking-widest">
            <i data-lucide="shield-check" class="w-4 h-4"></i>
            <span>West Coast Quad – La Mission</span>
          </div>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-white leading-tight">
            Un’esperienza indimenticabile tra <span class="text-amber-500">adrenalina</span> e scoperta
          </h2>
          <p class="text-neutral-300 text-base sm:text-lg leading-relaxed">
            Unisciti a noi per un’escursione in quad nelle affascinanti miniere, dove il passato minerario incontra l’emozione della guida off-road. Immagina di sfrecciare su sentieri avvincenti, affrontando ostacoli naturali che metteranno alla prova le tue capacità: pietre, fango e curve strette si intrecciano in un percorso panoramico nel cuore della terra.
          </p>
          <p class="text-neutral-400 text-sm sm:text-base leading-relaxed">
            Ogni tappa svelerà i segreti delle miniere abbandonate, con scenari mozzafiato e storie affascinanti che raccontano il duro lavoro dei minatori di un tempo. Perfetto per famiglie, gruppi di amici o chi cerca una nuova sfida, le nostre escursioni sono adatte a tutti: i nostri esperti istruttori ti guideranno in totale sicurezza.
          </p>
          
          <div class="pt-4 flex items-center gap-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
                <i data-lucide="users" class="w-6 h-6"></i>
              </div>
              <div>
                <p class="text-xs text-neutral-400 uppercase font-semibold">Per Tutti</p>
                <p class="text-sm font-bold text-white">Famiglie & Gruppi</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
                <i data-lucide="award" class="w-6 h-6"></i>
              </div>
              <div>
                <p class="text-xs text-neutral-400 uppercase font-semibold">Sicurezza</p>
                <p class="text-sm font-bold text-white">Istruttori Esperti</p>
              </div>
            </div>
          </div>
        </div>

        <!-- FOTO ACCATTIVANTE MISSION -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl group">
            <img src="https://www.westcoastquad.it/wp-content/uploads/2024/06/hero4-1024x576.jpg" alt="Quad Experience Mission" class="w-full h-[450px] object-cover group-hover:scale-105 transition-transform duration-700">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 glass-panel p-4 rounded-2xl">
              <p class="text-xs uppercase text-amber-400 font-bold">Inizia L'Avventura</p>
              <p class="text-sm text-neutral-200 mt-1">Senti il motore ruggire e scopri un mondo unico.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BENTO GRID SERVIZI / PERCORSI -->
  <section id="percorsi" class="py-24 px-6 relative bg-neutral-900/50" x-data="{ selectedRoute: null }">
    <div class="max-w-7xl mx-auto">
      
      <!-- INTESTAZIONE SEZIONE -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-amber-500 text-xs font-extrabold uppercase tracking-widest">Esplora i Nostri Itinerari</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mt-2">I Nostri Percorsi</h2>
        <p class="text-neutral-400 mt-4 text-sm sm:text-base">Scegli il percorso perfetto per il tuo livello di sfida e vivi un'esperienza guidata memorabile.</p>
      </div>

      <!-- BENTO GRID -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- CARD 1: LE MINIERE (BENTO LARGE) -->
        <div class="md:col-span-2 glass-card rounded-3xl overflow-hidden relative group flex flex-col justify-between min-h-[420px] p-8 border border-white/5 hover:border-amber-500/40 transition-all duration-500">
          <div class="absolute inset-0 z-0">
            <img src="https://www.westcoastquad.it/wp-content/uploads/2024/08/hero21.jpg" alt="Le Miniere" class="w-full h-full object-cover opacity-40 group-hover:scale-105 transition-transform duration-700">
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/70 to-transparent"></div>
          </div>

          <div class="relative z-10 flex justify-between items-start">
            <span class="px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider border border-emerald-500/30">
              Difficoltà: Facile
            </span>
            <span class="text-amber-400 font-bold text-xs uppercase tracking-widest glass-panel px-3 py-1 rounded-full">
              70 KM · 3/4 HR
            </span>
          </div>

          <div class="relative z-10 mt-20">
            <h3 class="text-3xl font-extrabold text-white mb-2 group-hover:text-amber-400 transition-colors">LE MINIERE</h3>
            <p class="text-neutral-300 text-base max-w-xl font-light">
              Un percorso avvincente, unico, meraviglioso. Sfreccia tra paesaggi suggestivi ed entra nel cuore della storia mineraria.
            </p>

            <div class="mt-6 flex items-center justify-between">
              <button @click="selectedRoute = { title: 'LE MINIERE', diff: 'FACILE', time: '3/4 HR', km: '70 KM', desc: 'Un percorso avvincente, unico, meraviglioso. Esplora le storiche miniere con passaggi panoramici ideali anche per chi è alla prima esperienza in quad.', img: 'https://www.westcoastquad.it/wp-content/uploads/2024/08/hero21.jpg' }" class="inline-flex items-center gap-2 text-xs font-bold uppercase text-amber-400 hover:text-amber-300">
                <span>Dettagli Percorso</span>
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
              </button>
              <a href="tel:+393460207324" class="px-4 py-2 rounded-full bg-amber-500 hover:bg-amber-400 text-neutral-950 text-xs font-bold uppercase tracking-wider transition-colors">
                Prenota
              </a>
            </div>
          </div>
        </div>

        <!-- CARD 2: I FIUMI ROSSI -->
        <div class="glass-card rounded-3xl overflow-hidden relative group flex flex-col justify-between min-h-[420px] p-8 border border-white/5 hover:border-amber-500/40 transition-all duration-500">
          <div class="absolute inset-0 z-0">
            <img src="https://www.westcoastquad.it/wp-content/uploads/2024/08/hero31.jpg" alt="I Fiumi Rossi" class="w-full h-full object-cover opacity-35 group-hover:scale-105 transition-transform duration-700">
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/70 to-transparent"></div>
          </div>

          <div class="relative z-10 flex justify-between items-start">
            <span class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-wider border border-amber-500/30">
              Difficoltà: Medio
            </span>
            <span class="text-neutral-300 font-bold text-xs uppercase tracking-widest glass-panel px-3 py-1 rounded-full">
              90 KM
            </span>
          </div>

          <div class="relative z-10">
            <h3 class="text-2xl font-extrabold text-white mb-2 group-hover:text-amber-400 transition-colors">I FIUMI ROSSI</h3>
            <p class="text-neutral-300 text-sm font-light mb-4">
              Suggestivo, difficoltà tecnica e presenza di ostacoli naturali lungo il tracciato.
            </p>
            <div class="text-xs text-neutral-400 mb-6 flex items-center gap-2">
              <i data-lucide="clock" class="w-4 h-4 text-amber-400"></i>
              <span>Durata: 4/5 HR</span>
            </div>

            <button @click="selectedRoute = { title: 'I FIUMI ROSSI', diff: 'MEDIO', time: '4/5 HR', km: '90 KM', desc: 'Percorso suggestivo caratterizzato da una moderata difficoltà tecnica e dalla presenza di affascinanti ostacoli naturali.', img: 'https://www.westcoastquad.it/wp-content/uploads/2024/08/hero31.jpg' }" class="w-full py-3 rounded-full glass-panel hover:bg-white/10 text-xs font-bold text-white uppercase tracking-wider transition-colors text-center border border-white/10">
              Esplora Dettagli
            </button>
          </div>
        </div>

        <!-- CARD 3: VILLA GINESTRA -->
        <div class="glass-card rounded-3xl overflow-hidden relative group flex flex-col justify-between min-h-[380px] p-8 border border-white/5 hover:border-amber-500/40 transition-all duration-500">
          <div class="absolute inset-0 z-0">
            <img src="https://www.westcoastquad.it/wp-content/uploads/2024/08/hero41.jpg" alt="Villa Ginestra" class="w-full h-full object-cover opacity-35 group-hover:scale-105 transition-transform duration-700">
            <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/70 to-transparent"></div>
          </div>

          <div class="relative z-10 flex justify-between items-start">
            <span class="px-3 py-1 rounded-full bg-red-500/20 text-red-400 text-xs font-bold uppercase tracking-wider border border-red-500/30">
              Difficoltà: Difficile
            </span>
            <span class="text-neutral-300 font-bold text-xs uppercase tracking-widest glass-panel px-3 py-1 rounded-full">
              100 KM
            </span>
          </div>

          <div class="relative z-10">
            <h3 class="text-2xl font-extrabold text-white mb-2 group-hover:text-amber-400 transition-colors">VILLA GINESTRA</h3>
            <p class="text-neutral-300 text-sm font-light mb-4">
              Difficile ed emozionante, con ostacoli naturali impegnativi per veri amanti dell'off-road.
            </p>
            <div class="text-xs text-neutral-400 mb-6 flex items-center gap-2">
              <i data-lucide="clock" class="w-4 h-4 text-amber-400"></i>
              <span>Durata: 6/7 HR</span>
            </div>

            <button @click="selectedRoute = { title: 'VILLA GINESTRA', diff: 'DIFFICILE', time: '6/7 HR', km: '100 KM', desc: 'Il percorso definitivo per chi cerca adrenalina pura. 100 km di ostacoli naturali, salite e discese mozzafiato.', img: 'https://www.westcoastquad.it/wp-content/uploads/2024/08/hero41.jpg' }" class="w-full py-3 rounded-full glass-panel hover:bg-white/10 text-xs font-bold text-white uppercase tracking-wider transition-colors text-center border border-white/10">
              Esplora Dettagli
            </button>
          </div>
        </div>

        <!-- BENTO CARD 4: ADRENALINA & SICUREZZA -->
        <div class="md:col-span-2 glass-card rounded-3xl p-8 border border-white/5 flex flex-col justify-between relative overflow-hidden bg-gradient-to-br from-neutral-900 via-neutral-900/80 to-amber-950/30">
          <div class="flex items-center gap-3 text-amber-400 mb-4">
            <i data-lucide="zap" class="w-6 h-6"></i>
            <span class="text-xs uppercase font-extrabold tracking-widest">Esperienza Guidata</span>
          </div>

          <div>
            <h3 class="text-2xl font-bold text-white mb-3">Pietre, fango e panorami incontaminati</h3>
            <p class="text-neutral-300 text-sm leading-relaxed font-light">
              Metti alla prova le tue capacità di guida off-road tra curve strette, avvallamenti e discese ripide. I nostri istruttori certificati ti assicureranno un'avventura elettrizzante in totale sicurezza.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-white/10 flex flex-wrap gap-6 text-xs text-neutral-400">
            <div class="flex items-center gap-2">
              <i data-lucide="check-circle" class="w-4 h-4 text-amber-400"></i>
              <span>Caschi ed equipaggiamento inclusi</span>
            </div>
            <div class="flex items-center gap-2">
              <i data-lucide="check-circle" class="w-4 h-4 text-amber-400"></i>
              <span>Briefing iniziale</span>
            </div>
            <div class="flex items-center gap-2">
              <i data-lucide="check-circle" class="w-4 h-4 text-amber-400"></i>
              <span>Foto e ricordi indimenticabili</span>
            </div>
          </div>
        </div>

      </div>

      <!-- ALPINE MODAL DETTAGLI PERCORSI -->
      <div x-show="selectedRoute" x-transition.opacity x-cloak class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
        <div @click.away="selectedRoute = null" class="glass-panel rounded-3xl max-w-lg w-full overflow-hidden border border-amber-500/30 shadow-2xl p-6 relative">
          <button @click="selectedRoute = null" class="absolute top-4 right-4 text-neutral-400 hover:text-white p-2 rounded-full glass-panel">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>

          <img :src="selectedRoute?.img" :alt="selectedRoute?.title" class="w-full h-48 object-cover rounded-2xl mb-4">
          
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400" x-text="selectedRoute?.diff"></span>
            <span class="text-xs font-semibold text-neutral-400" x-text="selectedRoute?.km + ' · ' + selectedRoute?.time"></span>
          </div>

          <h3 class="text-2xl font-extrabold text-white mb-2" x-text="selectedRoute?.title"></h3>
          <p class="text-neutral-300 text-sm leading-relaxed mb-6" x-text="selectedRoute?.desc"></p>

          <div class="flex gap-3">
            <a href="tel:+393460207324" class="flex-1 py-3 text-center bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold rounded-full text-xs uppercase tracking-wider transition-colors">
              Prenota Telefonicamente
            </a>
            <button @click="selectedRoute = null" class="px-5 py-3 rounded-full glass-panel hover:bg-white/10 text-xs font-bold text-white uppercase">
              Chiudi
            </button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- GALLERIA FOTOGRAFICA -->
  <section id="galleria" class="py-24 px-6 bg-neutral-950">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-amber-500 text-xs font-extrabold uppercase tracking-widest">Scatti dal Vivo</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-white mt-2">Galleria Avventura</h2>
        </div>
        <p class="text-neutral-400 text-sm max-w-md mt-4 md:mt-0">
          Un'anteprima visiva dei paesaggi, dei quad e dei momenti epici vissuti dai nostri ospiti.
        </p>
      </div>

      <!-- MASONRY GRID GALLERIA -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="overflow-hidden rounded-2xl border border-white/5 group">
          <img src="https://www.westcoastquad.it/wp-content/uploads/2024/08/image00002-819x1024.jpg" alt="West Coast Quad Photo 1" class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500">
        </div>
        <div class="overflow-hidden rounded-2xl border border-white/5 group">
          <img src="https://www.westcoastquad.it/wp-content/uploads/2024/08/image00003-819x1024.jpg" alt="West Coast Quad Photo 2" class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500">
        </div>
        <div class="overflow-hidden rounded-2xl border border-white/5 group">
          <img src="https://www.westcoastquad.it/wp-content/uploads/2024/08/image00004-1024x768.jpg" alt="West Coast Quad Photo 3" class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500">
        </div>
        <div class="overflow-hidden rounded-2xl border border-white/5 group">
